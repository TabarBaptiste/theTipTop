// ===========================================
// Schéma Prisma - Thé Tip Top
// ===========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// UTILISATEURS
// ===========================================
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?   // Null si connexion OAuth uniquement
  firstName     String
  lastName      String
  birthDate     DateTime?
  gender        Gender?
  phone         String?

  // OAuth providers
  googleId      String?   @unique
  facebookId    String?   @unique

  // Rôle
  role          Role      @default(CLIENT)

  // RGPD - Consentements
  consentEmail  Boolean   @default(false)
  consentData   Boolean   @default(false)

  // Relations
  participations Participation[]
  leads          Lead[]                       // Leads confirmes ayant abouti a ce compte

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // Soft delete pour RGPD

  @@index([email])
  @@index([googleId])
  @@index([facebookId])
  @@map("users")
}

enum Role {
  CLIENT
  EMPLOYEE
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// ===========================================
// TICKETS (500 000 codes pré-générés)
// ===========================================
model Ticket {
  id            String    @id @default(uuid())
  code          String    @unique @db.VarChar(10)

  // Gain associé (pré-attribué à la génération)
  prizeType     PrizeType

  // Statut
  isUsed        Boolean   @default(false)      // Code utilisé par un client
  isDistributed Boolean   @default(false)      // Ticket imprimé/donné en magasin

  // Relation avec participation
  participation Participation?

  // Leads ayant visé ce code sans avoir encore confirmé leur email
  leads         Lead[]

  // Timestamps
  createdAt     DateTime  @default(now())
  usedAt        DateTime?

  @@index([code])
  @@index([isUsed])
  @@index([isDistributed])
  @@index([prizeType])
  @@map("tickets")
}

enum PrizeType {
  INFUSER       // 60% - Infuseur à thé
  TEA_DETOX     // 20% - Boite 100g thé détox ou infusion
  TEA_SIGNATURE // 10% - Boite 100g thé signature
  GIFT_BOX_39   // 6%  - Coffret découverte 39€
  GIFT_BOX_69   // 4%  - Coffret découverte 69€
}

// ===========================================
// LOTS DU CONCOURS (métadonnées gérées en DB)
// ===========================================
model Prize {
  id           String    @id @default(uuid())
  code         PrizeType @unique          // Identifiant technique du lot
  name         String                     // "Infuseur à thé"
  description  String                     // Description courte
  imageUrl     String?                    // URL/chemin de l'image (optionnel)
  value        String?                     // "12€"
  percentage   Float                      // 60.0 (% des tickets)
  totalCount   Int                        // 300000
  displayOrder Int       @default(0)      // Ordre d'affichage

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("prizes")
}

// ===========================================
// PARTICIPATIONS (lien User <-> Ticket)
// ===========================================
model Participation {
  id            String    @id @default(uuid())

  // Relations
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId      String    @unique
  ticket        Ticket    @relation(fields: [ticketId], references: [id])

  // Remise du lot
  prizeDelivered     Boolean   @default(false)
  prizeDeliveredAt   DateTime?
  prizeDeliveredBy   String?   // ID de l'employé qui a remis le lot
  deliveryMethod     DeliveryMethod?

  // Timestamps
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([prizeDelivered])
  @@index([createdAt])
  @@map("participations")
}

enum DeliveryMethod {
  IN_STORE  // Remis en boutique
  ONLINE    // Envoyé (futur site e-commerce)
}

// ===========================================
// LEADS (tunnel de participation - UC-05)
// ===========================================
// Un lead est un prospect ayant soumis le formulaire public sans compte.
// Ce n'est PAS un utilisateur : tant que l'email n'est pas verifie, aucune
// ligne users n'est creee. A la confirmation du code, on cree le compte et
// la participation, puis on relie les deux via userId.
model Lead {
  id            String     @id @default(uuid())

  // Donnees personnelles saisies au formulaire
  email         String
  firstName     String
  lastName      String
  phone         String?
  birthDate     DateTime?
  gender        Gender?

  status        LeadStatus @default(EN_ATTENTE_VERIFICATION)

  // Code de verification email : 6 chiffres, 48h (RG-06).
  // Chaque renvoi invalide le precedent et repousse l'echeance (RG-07).
  verificationCode String?   @db.VarChar(6)
  codeExpiresAt    DateTime?
  lastCodeSentAt   DateTime?                  // Verrou de 60 s entre deux envois (RG-07)
  resendCount      Int       @default(0)      // Au-dela de 2, proposer de corriger l'email (RG-08)

  // Relances automatiques a J+24h, J+36h et J+47h (RG-20)
  remindersSent Int        @default(0)

  // RGPD : horodatage du consentement, obligatoire (RG-02)
  rgpdConsentAt DateTime
  consentEmail  Boolean    @default(false)

  // Recommandation CNIL du 14/04/2026 : le consentement au pixel de tracking
  // est distinct du consentement a recevoir des emails. Accepter la newsletter
  // ne vaut pas acceptation du suivi d'ouverture.
  // null = inconnu (jamais demande), ce qui correspond au statut « unknown »
  // de Brevo et se mappe sur contactPixelTrackingConsent.
  pixelTrackingConsent   Boolean?
  pixelTrackingConsentAt DateTime?

  // Compte cree a la confirmation
  userId        String?
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Ticket vise par le lead. Aucune reservation : le code reste soumettable par
  // d'autres tant que l'email n'est pas confirme, la consommation n'a lieu qu'a
  // la verification.
  ticketId      String?
  ticket        Ticket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  verifiedAt    DateTime?
  purgeAfter    DateTime?                     // Expire + 30 j, puis suppression (RG-21)

  @@index([email])
  @@index([status])
  @@index([codeExpiresAt])                    // Job d'expiration des leads (RG-21)
  @@index([purgeAfter])                       // Job de purge (RG-21)
  @@map("leads")
}

enum LeadStatus {
  EN_ATTENTE_VERIFICATION  // Code envoye, en attente de saisie
  VERIFIE                  // Email confirme, compte cree
  EXPIRE                   // 48h depassees sans confirmation
}

// ===========================================
// CONFIGURATION DU JEU-CONCOURS
// ===========================================
model GameConfig {
  id            String    @id @default(uuid())

  // Dates du jeu
  startDate     DateTime                    // Début du jeu
  endDate       DateTime                    // Fin distribution tickets (30 jours)
  claimEndDate  DateTime                    // Fin réclamation lots (+30 jours)

  // Limites
  maxTickets    Int       @default(500000)

  // Grand Prix
  grandPrizeDrawn     Boolean   @default(false)
  grandPrizeWinnerId  String?
  grandPrizeDrawnAt   DateTime?

  // Status
  isActive      Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("game_configs")
}

// ===========================================
// LOGS D'AUDIT (RGPD)
// ===========================================
model AuditLog {
  id            String    @id @default(uuid())
  userId        String?
  action        String    // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity        String    // User, Ticket, Participation, etc.
  entityId      String?
  oldValue      Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ===========================================
// REFRESH TOKENS
// ===========================================
model RefreshToken {
  id            String    @id @default(uuid())
  token         String    @unique
  userId        String
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ===========================================
// ABONNES A LA NEWSLETTER
// ===========================================
// Le formulaire du pied de page alimente une liste Brevo. L'adresse est
// d'abord conservee ici, puis poussee : si Brevo est injoignable ou mal
// configure, l'inscription n'est pas perdue et reste rattrapable.
model NewsletterSubscriber {
  id            String    @id @default(uuid())
  email         String    @unique

  // Horodatage du consentement, base legale de la conservation (RGPD).
  subscribedAt  DateTime  @default(now())

  // null tant que la synchronisation vers Brevo n'a pas abouti.
  brevoSyncedAt DateTime?

  // Motif du dernier echec, pour diagnostiquer sans relire les journaux.
  brevoError    String?

  unsubscribedAt DateTime?

  @@index([brevoSyncedAt])
  @@map("newsletter_subscribers")
}
