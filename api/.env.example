# ===========================================
# Configuration API Thé Tip Top
# ===========================================

# --- Base de données ---
DATABASE_URL="postgresql://thetiptop:password@localhost:5432/thetiptop?schema=public"

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# JWT_EXPIRATION       : durée de vie de l'access token (court, ex: 15m)
# JWT_REFRESH_EXPIRATION : durée de vie du refresh token (long, ex: 7d)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- OAuth2 Google ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# --- OAuth2 Facebook ---
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/v1/auth/facebook/callback

# --- Application ---
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Rate Limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Email transactionnel (Brevo) ---
# Clé API v3, à créer dans Brevo : Compte > SMTP & API > Clés API.
# Ce n'est PAS une clé MCP ni des identifiants SMTP.
# Laissée vide, les emails sont journalisés au lieu d'être envoyés : le tunnel
# de participation reste utilisable en local et en intégration continue.
BREVO_API_KEY=
# L'expéditeur doit être un domaine ou une adresse validés dans Brevo,
# sinon l'API refuse l'envoi.
BREVO_SENDER_EMAIL=noreply@thetiptop.fr
BREVO_SENDER_NAME="Thé Tip Top"

# --- Email (pour les notifications) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@thetiptop.com
SMTP_PASSWORD=smtp-password
SMTP_FROM="Thé Tip Top <noreply@thetiptop.com>"

# --- Sentry (monitoring erreurs) ---
SENTRY_DSN=

# --- Dates du jeu-concours ---
# Format: ISO 8601
GAME_START_DATE=2026-09-01T00:00:00.000Z
GAME_END_DATE=2026-09-30T23:59:59.999Z
# Exactement 30 jours apres la cloture, comme l'exige le CDC et comme l'annoncent
# les articles 3 et 6 du reglement depose. La valeur precedente accordait 32
# jours : plus genereuse, mais en desaccord avec le document publie.
CLAIM_END_DATE=2026-10-30T23:59:59.999Z
