# ===========================================
# Configuration API Thé Tip Top
# ===========================================

# --- Base de données ---
DATABASE_URL="postgresql://thetiptop:password@localhost:5432/thetiptop?schema=public"

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# JWT_EXPIRATION       : durée de vie de l'access token (court, ex: 15m)
# JWT_REFRESH_EXPIRATION : durée de vie du refresh token (long, ex: 7d)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- OAuth2 Google ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# --- OAuth2 Facebook ---
# A creer sur https://developers.facebook.com : application de type Grand public,
# produit « Connexion Facebook ». L'URI de redirection doit correspondre au
# caractere pres a FACEBOOK_CALLBACK_URL ci-dessous.
#
# Deux points bloquent souvent :
#   - en mode Developpement, seuls les administrateurs et les testeurs declares
#     peuvent se connecter. Les autres comptes recoivent une erreur Meta ;
#   - hors localhost, Meta exige HTTPS pour l'URI de redirection.
#
# Tant que ces valeurs restent des placeholders, le bouton Facebook echoue cote
# Meta, avant meme d'atteindre l'API.
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/v1/auth/facebook/callback

# --- Application ---
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
# Ajouter http://host.docker.internal:3000 pour executer Cypress depuis son
# image Docker : le navigateur du conteneur se presente sous cette origine.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Rate Limiting ---
# Trois paliers par IP : la rafale (1 s), la minute (10 s), la fenetre longue.
# Les valeurs ci-dessous sont celles de production. Une campagne de charge k6,
# emise depuis une seule adresse, doit les relever le temps du test — sinon
# elle ne mesure que le limiteur (cf. docs/05-PROTOCOLES-DE-TESTS.md).
THROTTLE_SHORT_LIMIT=3
THROTTLE_MEDIUM_LIMIT=20
# Fenetre longue : TTL en secondes.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Email transactionnel (Brevo) ---
# Clé API v3, à créer dans Brevo : Compte > SMTP & API > Clés API.
# Ce n'est PAS une clé MCP ni des identifiants SMTP.
# Laissée vide, les emails sont journalisés au lieu d'être envoyés : le tunnel
# de participation reste utilisable en local et en intégration continue.
BREVO_API_KEY=
# L'expéditeur doit être un domaine ou une adresse validés dans Brevo,
# sinon l'API refuse l'envoi.
BREVO_SENDER_EMAIL=noreply@thetiptop.fr
BREVO_SENDER_NAME="Thé Tip Top"

# --- Email (pour les notifications) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@thetiptop.com
SMTP_PASSWORD=smtp-password
SMTP_FROM="Thé Tip Top <noreply@thetiptop.com>"

# --- Images (Cloudinary) ---
# A creer sur https://cloudinary.com : le tableau de bord affiche les trois
# valeurs sous « View API Keys ».
#
# Le cloud name n'est pas un secret : il apparait dans chaque URL d'image
# servie par le site. La cle d'API ne vaut rien sans le secret, qui lui ne doit
# jamais quitter ce fichier.
#
# Laissees vides, la seed enregistre imageUrl a null et l'interface retombe sur
# les images empaquetees dans webapp/src/img : le site reste complet, et
# l'integration continue n'a besoin d'aucun compte.
#
# Pour envoyer ou remplacer les visuels : npm run images:upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Sentry (monitoring erreurs) ---
SENTRY_DSN=

# --- Dates du jeu-concours ---
# Format ISO 8601, en UTC. Les instants ci-dessous correspondent aux bornes
# telles qu'un participant francais les vit :
#
#   ouverture   -> mardi 1er septembre 2026 a 00:00:00 heure de Paris
#   cloture     -> mercredi 30 septembre 2026 a 23:59:59
#   reclamation -> vendredi 30 octobre 2026 a 23:59:59
#
# Le decalage n'est pas constant : +02:00 en septembre (heure d'ete), +01:00 le
# 30 octobre, l'heure d'ete prenant fin le 25. Ecrire naivement T23:59:59.999Z
# placait ces bornes au lendemain matin heure francaise, et l'email d'expiration
# annoncait une date de fin decalee d'un jour.
#
# Le jeu court du 23 aout au 23 septembre inclus, soit 32 jours calendaires,
# puis 30 jours pour reclamer son lot. Ces bornes sont repliquees cote
# interface dans webapp/src/lib/game-dates.ts, et un test compare les deux
# fichiers : modifier l'un sans l'autre fait echouer la suite.
#
# Le 23 octobre 2026 precede le retour a l'heure d'hiver, fixe au 25 : les
# trois dates sont donc exprimees en UTC+2.
GAME_START_DATE=2026-08-22T22:00:00.000Z
GAME_END_DATE=2026-09-23T21:59:59.999Z
CLAIM_END_DATE=2026-10-23T21:59:59.999Z

# --- Newsletter ---
# Identifiant numerique de la liste Brevo alimentee par le formulaire du pied
# de page (Brevo > Contacts > Listes). Sans lui, les inscriptions sont
# enregistrees en base sans etre poussees.
BREVO_NEWSLETTER_LIST_ID=
