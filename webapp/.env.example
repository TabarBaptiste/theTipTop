# ===========================================
# Configuration Frontend Thé Tip Top
# ===========================================

# --- API ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- OAuth2 (côté client) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# --- Site ---
# ATTENTION : cette valeur sert de base a toutes les URL absolues destinees aux
# moteurs de recherche — balises canoniques, plan du site, images Open Graph.
# La laisser sur localhost en production reviendrait a declarer des adresses
# inatteignables et a saborder le referencement.
#
# En production : https://thetiptop.dsp5-archi-o24a-4-5-g1.fr
# Non renseignee, le code retombe sur cette meme adresse.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Thé Tip Top"

# --- Google Search Console ---
# Code de verification de propriete, fourni par Search Console au choix de la
# methode « balise HTML ». Coller uniquement le contenu de l'attribut content,
# pas la balise entiere.
#
# Ne pas compter sur la verification par Google Analytics : la balise GA ne se
# charge qu'apres consentement aux cookies, et le robot de verification n'en
# donne aucun.
#
# Laissee vide, aucune balise n'est emise — utile en developpement.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Analytics ---
NEXT_PUBLIC_GA_ID=
