# ===========================================
# Configuration Frontend Thé Tip Top
# ===========================================

# --- API ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- OAuth2 (côté client) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# --- Site ---
# ATTENTION : cette valeur sert de base a toutes les URL absolues destinees aux
# moteurs de recherche — balises canoniques, plan du site, images Open Graph.
# La laisser sur localhost en production reviendrait a declarer des adresses
# inatteignables et a saborder le referencement.
#
# En production : https://thetiptop.dsp5-archi-o24a-4-5-g1.fr
# Non renseignee, le code retombe sur cette meme adresse.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Thé Tip Top"

# --- Analytics ---
NEXT_PUBLIC_GA_ID=
