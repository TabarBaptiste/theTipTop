# ===========================================
# Configuration Frontend Thé Tip Top
# ===========================================

# --- API ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- OAuth2 (côté client) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Thé Tip Top"

# --- Dates du jeu (pour affichage) ---
NEXT_PUBLIC_GAME_START_DATE=2026-09-01T00:00:00.000Z
NEXT_PUBLIC_GAME_END_DATE=2026-09-30T23:59:59.999Z
NEXT_PUBLIC_CLAIM_END_DATE=2026-11-01T23:59:59.999Z

# --- Analytics ---
NEXT_PUBLIC_GA_ID=
