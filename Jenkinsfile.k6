/* groovylint-disable CompileStatic, NoDef, UnusedVariable, VariableName, VariableTypeRequired */
@Library('furious-ducks-shared-library') _

def projectName = 'thetiptop'

k6Pipeline(
    projectName: projectName,

    // PREPROD et non PROD : PREPROD est iso-prod, et charger le site client
    // livré le dégraderait pour de vrais utilisateurs.
    targetUrl  : "https://${projectName}-preprod.wk-archi-o24a-4-5-g1.fr",

    k6Script   : 'tests/performance/load-test.js',

    // Profil identique à celui que le stage utilisait (valeurs par défaut de
    // la library), pour que les premiers runs planifiés soient directement
    // comparables aux builds historiques.
    k6Vus      : 50,
    k6Duration : '3m',

    // 'H' répartit l'heure de départ pour éviter que plusieurs projets
    // planifiés le même jour démarrent tous à 02:00 pile.
    cron       : 'H 2 * * 1'   // tous les lundis vers 02:00
)