{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "webapp",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "cwd": "webapp",
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:dev"],
      "port": 3001,
      "cwd": "api"
    },
    {
      "name": "webapp-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": ["serve-4000.js"],
      "port": 4000,
      "cwd": "webapp/.next-prod/standalone/webapp"
    }
  ]
}
